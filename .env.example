# Copy this file to .env for local development. Never commit real credentials.
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ai-mystery-room
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
SESSION_COOKIE_NAME=amr.sid
CASE_TTL_DAYS=7
GEMINI_TIMEOUT_MS=120000
MAX_CASE_GENERATION_RETRIES=1
